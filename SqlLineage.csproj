<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishAot>false</PublishAot>
    <RootNamespace>SqlLineage</RootNamespace>
    <AssemblyName>SqlLineage</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CS8618</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="ClosedXML" Version="0.105.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Data" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Globalization" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Xml.Linq" />
    <Using Include="ClosedXML.Excel" />
    <Using Include="Microsoft.Data.SqlClient" />
    <Using Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="out/**;bin/**;bin-win/**;obj/**;samples/**;SqlLineage.cs" />
  </ItemGroup>

</Project>
